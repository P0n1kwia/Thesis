#version 430 core

layout(local_size_x = 256) in;

layout(std430, binding = 5) readonly  buffer KeysBufferA    { uint keysA[]; };
layout(std430, binding = 8) writeonly buffer WgHistograms   { uint wgHistograms[]; };

uniform uint uCount;
uniform uint uShift;
uniform uint uMaxWorkgroups;

shared uint localHist[16];

void main()
{
    if (gl_LocalInvocationID.x < 16u) localHist[gl_LocalInvocationID.x] = 0u;
    barrier();

    uint base = gl_WorkGroupID.x * 1024u + gl_LocalInvocationID.x * 4u;
    for (uint j = 0u; j < 4u; ++j)
    {
        uint idx = base + j;
        if (idx < uCount)
        {
            uint digit = (keysA[idx] >> uShift) & 0xFu;
            atomicAdd(localHist[digit], 1u);
        }
    }
    barrier();

    if (gl_LocalInvocationID.x < 16u)
        wgHistograms[gl_LocalInvocationID.x * uMaxWorkgroups + gl_WorkGroupID.x] = localHist[gl_LocalInvocationID.x];
}
